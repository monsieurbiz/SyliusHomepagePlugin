{% extends '@MonsieurBizSyliusHomepagePlugin/admin/homepage_switch/layout.html.twig' %}
{% set history = filters.history|default(false) %}
{% set pending = filters.status|default(null) == 'pending' %}
{% set heading = history ? 'monsieurbiz_homepage.ui.switch.history' : 'monsieurbiz_homepage.ui.switch.title' %}

{% block content %}
    {% set route = 'monsieurbiz_homepage_admin_homepage_switch_index' %}
    <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
        {% if history %}
            <form method="get" action="{{ path(route) }}" class="d-flex flex-wrap align-items-end gap-2">
                <input type="hidden" name="history" value="1">
                <div>
                    <label class="form-label" for="history-channel">{{ 'sylius.ui.channel'|trans }}</label>
                    <select class="form-select" id="history-channel" name="channel">
                        <option disabled{% if filters.channel is null %} selected{% endif %}>{{ 'monsieurbiz_homepage.ui.switch.all_channels'|trans }}</option>
                        {% for channel in channels %}
                            <option value="{{ channel.code }}"{% if channel.code is same as(filters.channel) %} selected{% endif %}>{{ channel.name|default(channel.code) }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn">{{ 'sylius.ui.filter'|trans }}</button>
            </form>
            {% if filters.channel is not null %}
                <a class="btn" href="{{ path(route, {history: 1}) }}">{{ 'monsieurbiz_homepage.ui.switch.all_channels'|trans }}</a>
            {% endif %}
        {% else %}
            <a class="btn" href="{{ path(route, {history: 1}) }}">{{ 'monsieurbiz_homepage.ui.switch.history'|trans }}</a>
        {% endif %}
        {% if history or pending %}
            <a class="btn" href="{{ path(route) }}">{{ 'monsieurbiz_homepage.ui.switch.all_switches'|trans }}</a>
        {% endif %}
    </div>
    {% if history %}
        <p>{{ 'monsieurbiz_homepage.ui.switch.history_help'|trans }}</p>
    {% elseif pending and filters.target is not null %}
        <p>{{ 'monsieurbiz_homepage.ui.switch.pending_for_page'|trans({'%id%': filters.target}) }}</p>
    {% endif %}
    <div class="card">
        {% if switches is empty %}
            <div class="card-body">{{ (history ? 'monsieurbiz_homepage.ui.switch.history_empty' : (pending ? 'monsieurbiz_homepage.ui.switch.pending_empty' : 'monsieurbiz_homepage.ui.switch.empty'))|trans }}</div>
        {% else %}
            <div class="card-header">{{ 'monsieurbiz_homepage.ui.switch.timezone'|trans({'%timezone%': timezone}) }}</div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'sylius.ui.channel'|trans }}</th>
                            <th scope="col">{{ 'monsieurbiz_homepage.ui.switch.previous'|trans }}</th>
                            <th scope="col">{{ 'monsieurbiz_homepage.ui.switch.target'|trans }}</th>
                            <th scope="col">{{ 'monsieurbiz_homepage.ui.switch.form.scheduled_at'|trans }}</th>
                            <th scope="col">{{ 'monsieurbiz_homepage.ui.switch.executed_at'|trans }}</th>
                            <th scope="col">{{ 'sylius.ui.status'|trans }}</th>
                            {% if not history %}<th scope="col">{{ 'sylius.ui.actions'|trans }}</th>{% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for switch in switches %}
                            <tr>
                                <th scope="row">{{ switch.channel.name|default(switch.channel.code|default('#' ~ switch.channel.id)) }}</th>
                                <td>{% if switch.previous %}{% include '@MonsieurBizSyliusHomepagePlugin/admin/homepage/name.html.twig' with {data: switch.previous} only %}{% else %}—{% endif %}</td>
                                <td>{% include '@MonsieurBizSyliusHomepagePlugin/admin/homepage/name.html.twig' with {data: switch.target} only %}</td>
                                <td>{{ switch.scheduledAt|date('Y-m-d H:i:s P', timezone) }}</td>
                                <td>{{ switch.executedAt ? switch.executedAt|date('Y-m-d H:i:s P', timezone) : '—' }}</td>
                                <td>
                                    {{ ('monsieurbiz_homepage.ui.switch.status.' ~ switch.status)|trans }}
                                    {% if switch.reason %}
                                        <div class="text-secondary">{{ ('monsieurbiz_homepage.ui.switch.reason.' ~ switch.reason)|trans }}</div>
                                    {% endif %}
                                </td>
                                {% if not history %}
                                    <td>
                                        {% if switch.pending %}
                                            <div class="d-flex flex-wrap gap-1">
                                                <a class="btn btn-sm" href="{{ path('monsieurbiz_homepage_admin_homepage_switch_update', {id: switch.id}) }}">{{ 'monsieurbiz_homepage.ui.switch.update'|trans }}</a>
                                                <form method="post" action="{{ path('monsieurbiz_homepage_admin_homepage_switch_cancel', {id: switch.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('homepage_switch_cancel_' ~ switch.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'sylius.ui.cancel'|trans }}</button>
                                                </form>
                                            </div>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
